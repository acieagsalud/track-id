# Neon Postgres connection string (https://console.neon.tech). Leave unset to run in demo mode.
DATABASE_URL=

# Auth.js secret: generate with `npx auth secret`
AUTH_SECRET=

# Spotify app (https://developer.spotify.com/dashboard)
# Redirect URI: http://127.0.0.1:3000/api/auth/callback/spotify
AUTH_SPOTIFY_ID=
AUTH_SPOTIFY_SECRET=

# Contact email sent in the User-Agent to MixesDB
MIXESDB_CONTACT=

# "true" serves bundled demo data with no DB/Spotify/MixesDB calls
NEXT_PUBLIC_DEMO=false
